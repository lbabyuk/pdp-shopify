{% comment %}
  Renders product options

  Usage:
  {% render 'product-options' %}
{% endcomment %}

{%- assign color_index = -1 -%}
{%- assign size_index = -1 -%}

{%- for option in product.options -%}
  {%- assign option_normalized = option | downcase | strip -%}
  {%- if option_normalized contains 'color'
    or option_normalized contains 'colour'
    or option_normalized contains 'колір'
  -%}
    {%- assign color_index = forloop.index0 -%}
  {%- elsif option_normalized contains 'size'
    or option_normalized contains 'shoe size'
    or option_normalized contains 'розмір'
  -%}
    {%- assign size_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}

{%- if color_index >= 0 -%}
  {%- assign color_index_plus = color_index | plus: 1 -%}
  {%- assign color_key = 'option' | append: color_index_plus -%}
  {%- assign colors = product.variants | map: color_key | uniq -%}

  <div class="product_option" {{ shopify_attributes }}>
    <label for="color-select" class="sr-only">{{ 'products.product.select_color' | t | escape }}</label>
    <select id="color-select" name="color" class="sr-only">
      {%- for color in colors -%}
        <option value="{{ color | escape }}">{{ color }}</option>
      {%- endfor -%}
    </select>
    <div class="flex flex-wrap gap-2">
      {%- for color in colors -%}
        {%- assign variant = product.variants | where: color_key, color | first -%}
        {%- if variant and variant.featured_image -%}
          {%- assign image_url = variant.featured_image | image_url: width: 88 -%}
        {%- else -%}
          {%- assign image_url = product.featured_image | image_url: width: 88 -%}
        {%- endif -%}

        <label class="cursor-pointer color-label">
          <input
            type="radio"
            name="color"
            value="{{ color | escape }}"
            class="sr-only peer color-input"
            aria-label="Color-Input-{{ color}}"
            id="color-input-{{ color }}"
          >
          <span id="color-label-{{ forloop.index }}" class="sr-only">{{ color | escape }}</span>

          {% if image_url != blank %}
            <span
              tabindex="0"
              class="color__option block w-22 h-22 peer-checked:ring bg-center bg-cover focus-visible"
              style="background-image:url({{ image_url }});"
              title="{{ color | escape }}"
              role="presentation"
            ></span>
          {% else %}
            <span
              tabindex="0"
              class="block w-10 h-10 rounded-full ring-1 peer-checked:ring-1 focus-visible"
              style="background-color:{{ color | downcase }};"
              title="{{ color | escape  }}"
            ></span>
          {% endif %}
        </label>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{%- if size_index >= 0 -%}
  {%- assign size_index_plus = size_index | plus: 1 -%}
  {%- assign size_key = 'option' | append: size_index_plus -%}
  {%- assign sizes = product.variants | map: size_key | uniq -%}
  <div class="product_option" {{ shopify_attributes }}>
    <div class="product_option w-full flex flex-col gap-3">
      <span class="subtitle"> {{ product.options[size_index] | default: 'Select Size:' }}:</span>
      <div id="size-select" class="size-chips grid grid-cols-2 lg:grid-cols-3 gap-2">
        {%- for size in sizes -%}
          {%- assign safe_size = size | remove: '(' | remove: ')' | replace: ' ', '-' -%}
          <label class="chip cursor-pointer size-label focus-visible">
            <input
              type="radio"
              name="size"
              value="{{ size | escape }}"
              class="sr-only peer size-input"
              aria-label="size-input-{{ safe_size }}"
              id="size-input-{{ safe_size }}"
            >
            <span tabindex="0" class="size-option block subtitle text-center peer-checked:ring p-4 focus-visible">
              {{- size | escape -}}
            </span>
          </label>
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

<div
  id="variant-data"
  aria-hidden="true"
  data-color-index="{{ color_index }}"
  data-size-index="{{ size_index }}"
>
  {%- for variant in product.variants -%}
    <span
      data-id="{{ variant.id }}"
      data-option1="{{ variant.option1 | escape }}"
      data-option2="{{ variant.option2 | escape }}"
      data-option3="{{ variant.option3 | escape }}"
      data-media-id="{{ variant.featured_media.id }}"
      data-available="{{ variant.available }}"
    ></span>
  {%- endfor -%}
</div>
