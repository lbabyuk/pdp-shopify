{% comment %}
  Modal Size Guide snippet
  usage: {% render 'modal-size-guide', metafield: size_guide %}
{% endcomment %}

{% stylesheet %}
  .size-guide table {
    width: 100%;
    border-collapse: separate;
    text-align: center;
  }

  .size-guide td {
    padding: 16px;
    background: #fff;
  }

  .size-guide td:first-child {
    width: 140px;
  }

  .size-guide td:nth-child(n + 2) {
    width: 100px;
  }

  .size-guide table {
    width: 100%;
    border-collapse: collapse;
    text-align: center;
    font-size: 14px;
  }

  .size-guide td {
    padding: 8px;
  }

  .size-guide td:nth-child(2),
  .size-guide td:nth-child(4) {
    background: #f5f5f5;
  }

  .size-guide {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(17, 17, 17, 0.8);
    z-index: 9999;
    justify-content: center;
    align-items: center;
    padding: 1rem;
  }

  .modal-inner {
    background: #fff;
    padding: 48px;
    position: relative;
    overflow-y: auto;
    max-width: 644px;
    min-width: 50%;
    -webkit-animation-name: animatetop;
    -webkit-animation-duration: 0.4s;
    animation-name: animatetop;
    animation-duration: 0.4s;
  }

  @media (max-width: 700px) {
    .size-guide td:first-child {
      width: 100px;
      overflow: hidden;
      white-space: nowrap;
    }

    .modal-inner {
      width: 100%;
      height: auto;
      padding: 32px 16px;
      font-size: 14px;
    }

    .size-guide .close-modal {
      top: 10px;
      right: 10px;
    }
  }

  .size-guide .close-modal {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    cursor: pointer;
  }

  @-webkit-keyframes animatetop {
    from {
      top: -300px;
      opacity: 0;
    }
    to {
      top: 0;
      opacity: 1;
    }
  }

  @keyframes animatetop {
    from {
      top: -300px;
      opacity: 0;
    }
    to {
      top: 0;
      opacity: 1;
    }
  }
{% endstylesheet %}

<div id="sizeGuideModal" role="dialog" aria-modal="true" class="size-guide">
  <div class="modal-inner">
    <span id="sizeGuideTitle" class="sr-only">{{ 'buttons.size_guide' | t }}</span>
    <button class="close-modal cursor-pointer" aria-label="Close">
      {{ 'modal-close-icon.svg' | inline_asset_content }}
    </button>
    {% if metafield and metafield.value %}
      <section class="text subtitle md:body">{{ metafield }}</section>
    {% endif %}
  </div>
</div>
