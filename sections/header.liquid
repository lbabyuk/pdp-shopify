<header class="full-width header">
  <div class="header__container flex justify-between items-center h-14 w-full md:h-21 md:py-7.5 py-4 px-4 md:px-15">
    <div class="header__logo hidden md:block">
      <a href="{{ routes.root_url }}" aria-label="Logo" class="logo">
        {{ 'logo-icon.svg' | inline_asset_content }}
      </a>
    </div>
    <button
      class="header__button block md:hidden cursor-pointer"
      type="button"
      aria-controls="main-navigation"
      aria-label="Open main menu"
    >
      {{ 'menu-icon.svg' | inline_asset_content }}
    </button>
    <nav class="header__menu md:flex gap-8 hidden text-base" aria-label="Primary navigation">
      {% for link in linklists['main-menu'].links %}
        <a href="{{link.url}}" class="{% if link.active == true %}text-indigo-600{% endif %}">{{ link.title }}</a>
      {% endfor %}
    </nav>
    <div class="header__cart relative" aria-label="View cart">
      <a href="{{ routes.cart_url }}" class="relative transition-colors duration-300 group overflow-visible!">
        {% if cart.item_count > 0 %}
          <div class="cart-count-bubble">
            <sup
              role="status"
              aria-label="{{ cart.item_count }} items in cart"
              class="
                absolute w-5 h-5
                flex items-center justify-center top-0 left-4
                 -translate-x-1/4 -translate-y-1/4 rounded-full border border-black bg-black text-white group-hover:border-indigo-500  group-hover:text-indigo-500
              "
            >
              {{- cart.item_count -}}
            </sup>
          </div>
        {% endif %}

        <span class="transition-colors duration-300 group-hover:text-indigo-500">
          {{ 'icon-cart.svg' | inline_asset_content }}
        </span>
      </a>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "t:general.header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    }
  ]
}
{% endschema %}
